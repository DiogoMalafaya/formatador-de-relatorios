# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
# The repository is public: a committed key is a leaked key.

# --- Stripe (DIO-14, DIO-15) ---
# Use test-mode keys (sk_test_...) until the launch checklist in DIO-20.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (DIO-6) ---
# Firebase Storage, per the DIO-5 hosting decision (Vercel + Firebase). Values
# come from a Firebase service account JSON (Project settings > Service
# accounts > Generate new private key). The bucket must have a 24h lifecycle
# rule configured in the Firebase/GCP console — application code is the
# backstop for that guarantee, not the source of it.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Sessions (DIO-7) ---
# Random 32+ byte secret used to sign ephemeral session tokens.
# Generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=
