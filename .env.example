# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
# The repository is public: a committed key is a leaked key.

# --- Stripe (DIO-14, DIO-15) ---
# Use test-mode keys (sk_test_...) until the launch checklist in DIO-20.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (DIO-6) ---
# S3-compatible. The bucket must have a lifecycle rule enforcing the retention
# window agreed in DIO-6 — application code is the backstop, not the guarantee.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# --- Sessions (DIO-7) ---
# Random 32+ byte secret used to sign ephemeral session tokens.
# Generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=
