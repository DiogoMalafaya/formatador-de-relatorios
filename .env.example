# Copy to .env.local and fill in. .env* is gitignored — never commit real values.
# The repository is public: a committed key is a leaked key.

# --- Stripe (DIO-14, DIO-15) ---
# Use test-mode keys (sk_test_...) until the launch checklist in DIO-20.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Firebase (DIO-6 object storage, DIO-21 session store) ---
# One Firebase project, one service account, shared by both stores via
# src/lib/firebase-app.ts. Values come from a Firebase service account JSON
# (Project settings > Service accounts > Generate new private key).
#
# Object storage: the bucket should have a "Delete, age 1 day" lifecycle rule
# set in the GCP console (Firebase does not expose lifecycle rules) — but that
# rule is only a backstop with no timing guarantee. The actual 48h retention
# promise (DIO-19) is enforced by the app-level purge threshold
# (`OBJECT_TTL_MS`, currently 22h) and the scheduled cleanup job (DIO-16).
#
# Session store: the Firestore `sessions` collection needs a TTL policy on
# `expiresAt` set in the GCP console (same reason — no SDK exposure). Expiry
# is still enforced on every read regardless, since TTL collection timing is
# best-effort.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# --- Sessions (DIO-7) ---
# Random 32+ byte secret used to sign ephemeral session tokens.
# Generate with: openssl rand -base64 32
SESSION_SIGNING_SECRET=
